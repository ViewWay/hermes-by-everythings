{
  "name": "hermes-by-everythings",
  "version": "3.3.1",
  "description": "中文编码增强套件 - 基于 ECC v2.0,提供 30+ 专业代理、完整测试框架和自主闭环学习系统",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "claude-code",
    "ai",
    "agents",
    "skills",
    "chinese",
    "中文",
    "coding-assistance",
    "code-review",
    "tdd",
    "automation",
    "testing",
    "ralph",
    "orchestrator",
    "continuous-learning"
  ],
  "author": {
    "name": "ViewWay",
    "url": "https://github.com/ViewWay/hermes-by-everythings"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViewWay/hermes-by-everythings.git"
  },
  "homepage": "https://github.com/ViewWay/hermes-by-everythings#readme",
  "bugs": {
    "url": "https://github.com/ViewWay/hermes-by-everythings/issues"
  },
  "files": [
    "skills/",
    ".claude/commands/",
    ".claude/rules/",
    ".claude/config/",
    ".claude/settings.json",
    "scripts/",
    "tests/",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "SKILL.md"
  ],
  "bin": {
    "hbe": "scripts/hbe.js",
    "hbe-install": "scripts/install.sh"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('\\n  🎉 Hermes-by-Everything v3.3.1 installed!\\n  📚 Docs: https://github.com/ViewWay/hermes-by-everythings\\n')\"",
    "test": "bash tests/scripts/test-all.sh --fast",
    "test:full": "bash tests/scripts/test-all.sh",
    "test:agents": "bash tests/scripts/test-agents.sh",
    "test:skills": "bash tests/scripts/test-skills.sh",
    "test:docs": "bash tests/scripts/test-docs.sh",
    "install": "bash scripts/install.sh",
    "update": "bash scripts/update.sh",
    "status": "node scripts/hbe.js status",
    "build:mcp": "node scripts/build-mcp.mjs",
    "mcp:start": "node dist/mcp/rules-server.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node src/mcp/rules-server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
