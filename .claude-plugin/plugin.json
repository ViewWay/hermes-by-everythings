{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "hermes-by-everythings",
  "version": "3.3.1",
  "description": "多平台多语言编码增强套件。39 Agent + 33 Skill + 22 Command + 83 Rules + Ralph 自主循环。支持 TS/Python/Rust/Go/Java/Kotlin 等 10 种语言。",
  "author": {
    "name": "ViewWay",
    "url": "https://github.com/ViewWay"
  },
  "homepage": "https://github.com/ViewWay/hermes-by-everythings",
  "repository": "https://github.com/ViewWay/hermes-by-everythings",
  "license": "MIT",
  "skills": [
    "./skills/"
  ],
  "commands": [
    "./commands/"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "hbe-rules": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp/rules-server.js"],
      "cwd": "${CLAUDE_PROJECT_DIR}"
    }
  },
  "categories": [
    "development",
    "testing",
    "security",
    "code-quality"
  ],
  "keywords": [
    "coding-enhancement",
    "multi-language",
    "multi-platform",
    "tdd",
    "code-review",
    "security-review",
    "ralph",
    "autonomous-coding",
    "multi-agent"
  ]
}

