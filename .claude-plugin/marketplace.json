    "languages": ["typescript", "javascript", "python", "rust", "go", "java", "kotlin", "csharp", "ruby", "php", "swift"]
  },
  "entry": "SKILL.md",
  "commands": [
    "/hbe:plan",
    "/hbe:architect",
    "/hbe:tdd",
    "/hbe:review",
    "/hbe:security",
    "/hbe:build-fix",
    "/hbe:e2e",
    "/hbe:refactor",
    "/hbe:docs",
    "/hbe:prd",
    "/hbe:verify",
    "/hbe:orchestrate",
    "/hbe:ralph",
    "/hbe:checkpoint",
    "/hbe:learn",
    "/hbe:eval"
