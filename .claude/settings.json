{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Agent(*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-start.js"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/session-end.js"
          },
          {
            "type": "command",
            "command": "bash scripts/core/hooks/auto-learn.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/core/hooks/file-type-detect.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post-tool.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre-bash-dispatcher.js"
          }
        ]
      }
    ]
  },
  "triggers": {
    "keywords": [
      "hbe",
      "hermes",
      "hermes-by-everythings",
      "自主编码",
      "autonomous coding",
      "ralph",
      "ralph 循环",
      "全流程开发",
      "full workflow",
      "tdd",
      "test-driven development",
      "代码审查",
      "code review",
      "安全审查",
      "security review"
    ],
    "filePatterns": {
      ".ts": [
        "TypeScript 类型检查",
        "运行测试"
      ],
      ".tsx": [
        "React 组件测试",
        "类型检查"
      ],
      ".py": [
        "Python 类型检查 (mypy)",
        "Lint 检查 (ruff)"
      ],
      ".rs": [
        "Cargo 检查 (clippy)",
        "运行测试"
      ],
      "test": [
        "运行测试",
        "测试覆盖率"
      ],
      "package.json": [
        "依赖审查",
        "安全审计"
      ]
    },
    "gitEvents": {
      "pre-commit": [
        "代码审查",
        "安全检查"
      ],
      "pre-push": [
        "完整验证循环",
        "运行所有测试"
      ],
      "pr-created": [
        "安全审查",
        "代码审查"
      ]
    },
    "failures": {
      "build": "hbe-build-fix",
      "test": "hbe-tdd"
    }
  },
  "learning": {
    "enabled": true,
    "autoExtract": true,
    "minQualityScore": 70,
    "patternRepetitionThreshold": 3,
    "storage": {
      "memoryDir": "memory",
      "skillsDir": "skills",
      "statsFile": "learning-stats.json"
    },
    "triggers": {
      "onSessionEnd": true,
      "onRalphIteration": true,
      "onErrorFix": true,
      "onUserConfirmation": true,
      "onPatternRepetition": true
    }
  },
  "context": {
    "strategy": "layered",
    "compressionThreshold": 100000,
    "compressionTrigger": "session_rounds > 20 or context_size > 100k",
    "keepFresh": [
      "CLAUDE.md",
      "prd.json",
      "progress.md"
    ]
  },
  "ralph": {
    "autoStart": false,
    "maxIterations": 50,
    "checkpointInterval": 5,
    "resumeOnInterrupt": true,
    "progressFile": ".ralph-state.json",
    "checkpointFile": ".ralph-checkpoint.json",
    "logFile": ".ralph-log.jsonl"
  }
}
